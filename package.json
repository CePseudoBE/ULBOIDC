{
  "name": "ulboidc-ally",
  "description": "Ally kit to serve ULB Oidc authentication",
  "version": "3.0.0",
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build/index.js",
    "build/index.d.ts",
    "build/src"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import=@poppinss/ts-exec bin/test.ts unit",
    "test:integration": "node --import=@poppinss/ts-exec bin/test.ts integration",
    "test:all": "node --import=@poppinss/ts-exec bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/ally": "^6.3.2",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@types/node": "^26.6.6",
    "jose": "^6.2.17",
    "typescript": "~6.0.0",
    "undici": "^7.30.2"
  },
  "peerDependencies": {
    "@adonisjs/ally": "^6.1.0",
    "@adonisjs/core": "^7.0.0"
  },
  "author": "Hoffmann Axel",
  "license": "MIT",
  "keywords": [
    "social-auth",
    "adonisjs-ally",
    "adonisjs"
  ],
  "prettier": "@adonisjs/prettier-config",
  "dependencies": {
    "openid-client": "^6.8.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
